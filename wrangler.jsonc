{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htw0702-com",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
